# Use two different randomly generated values, at least 32 characters each.
CONTROL_API_TOKEN=
ZOT_HOST_TOKEN=

# Database state survives Sandbox deletion. Use a dedicated database and store.
ZOT_CONTINUOUS_POSTGRES_DSN=postgresql://user:password@example.neon.tech/zot?sslmode=verify-full
ZOT_STORE_NAME=main
# Set true only when you trust a managed provider reporting fsync=off, such as Neon.
ZOT_POSTGRES_TRUST_REMOTE_DURABILITY=false

ZOT_SANDBOX_NAME=zot-continuous
ZOT_SANDBOX_TIMEOUT_SECONDS=1800
ZOT_WEB_ORIGIN=https://web.zot.sh

# anthropic for Claude API or subscription, openai for API, openai-codex for subscription.
ZOT_PROVIDER=anthropic
ZOT_MODEL=claude-sonnet-4-6
# Start read-only. Enable write, edit, or bash only for trusted repositories and users.
ZOT_TOOLS=read,glob
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional subscription credentials. JSON contains a zot OAuth token object,
# not the whole auth.json file and not a Claude/Codex CLI credentials file.
# Never configure both an API key and OAuth for the selected provider.
# CLAUDE_OAUTH_JSON={"access_token":"...","refresh_token":"...","expiry":"2026-12-01T00:00:00Z"}
# CODEX_OAUTH_JSON={"access_token":"...","refresh_token":"...","expiry":"2026-12-01T00:00:00Z","account_id":"..."}

# Optional GitHub repository. The branch must already exist.
GIT_REPOSITORY=
GIT_BRANCH=main
GITHUB_TOKEN=
# Retain Git credentials in the agent process only when explicitly enabled.
GIT_ALLOW_PUSH=false

# Default artifact: the zot release pinned in src/config.ts (Linux amd64, SHA-256).
# A scheduled workflow opens a pull request when a new release is available.
# Set both values together to override with another verified release.
# ZOT_VERSION=
# ZOT_ARCHIVE_SHA256=

# Deployed Vercel Functions use project OIDC automatically.
# For external/local administration only, optionally supply all three:
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Preview controls are disabled by default to avoid touching production state.
# ALLOW_PREVIEW_CONTROL=false
