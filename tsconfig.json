{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
